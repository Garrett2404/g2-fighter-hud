    "pack": "npm run build && evenhub pack app.json dist -o hud.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/leaflet": "^1.9.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
