    "pack": "npm run build && evenhub pack app.json dist -o hud.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.9"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.5",
    "@evenrealities/evenhub-simulator": "^0.4.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
