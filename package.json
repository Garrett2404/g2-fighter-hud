{
  "name": "g2-fighter-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "qr": "evenhub qr --http -p 5173",
